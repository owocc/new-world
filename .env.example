# 复制为 .env 并填写
# 本地开发使用 file: 数据库；生产使用 Turso

# Database
LIBSQL_URL=file:./local.db
# LIBSQL_AUTH_TOKEN=your-turso-token

# Auth (生成方式: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 保护 /api/cron/tick（Vercel Cron 会以 Bearer token 携带）
CRON_SECRET=change-me

# Vercel Blob 存储凭证（从 Vercel Dashboard -> Storage -> Blob 获取）
# 本地若未配置会自动启用开发回退模式，生产环境必须配置
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx
